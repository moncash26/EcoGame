{
  "name": "eco-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "ECO: Tú contra ti — app para iOS y Android (Capacitor)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync && node scripts/configure-native.mjs",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#0A0C18' --iconBackgroundColorDark '#0A0C18' --splashBackgroundColor '#0A0C18' --splashBackgroundColorDark '#0A0C18'"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/native-purchases": "^8.8.1",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "esbuild": "^0.28.2"
  }
